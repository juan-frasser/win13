        <UserObject label="" plantUmlData="{&#xa;  &quot;data&quot;: &quot;@startuml\nactor Estudiante as E\nparticipant \&quot;Interfaz Web\&quot; as UI\nparticipant \&quot;Controlador\\nPostulación\&quot; as CP\nparticipant \&quot;Base de Datos\&quot; as BD\nactor Empresa as EMP\n\nE -&gt; UI : Inicia sesión y busca vacantes\nUI -&gt; CP : Solicitar lista de vacantes activas\nCP -&gt; BD : SELECT vacantes WHERE estado=&#39;Activa&#39;\nBD --&gt; CP : Retorna vacantes\nCP --&gt; UI : Mostrar vacantes\nE -&gt; UI : Selecciona vacante y hace clic en \&quot;Postularse\&quot;\nUI -&gt; CP : Enviar datos de postulación (ID_Estudiante, ID_Vacante)\nCP -&gt; BD : Validar si ya existe postulación previa\nBD --&gt; CP : Resultado de validación (No existe)\nCP -&gt; BD : INSERT nueva POSTULACION\nBD --&gt; CP : Confirmación de guardado\nCP -&gt; CP : Generar notificación para la Empresa\nCP --&gt; UI : Mostrar mensaje de \&quot;Postulación exitosa\&quot;\nCP --&gt; EMP : Enviar notificación de nueva postulación\n@enduml&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="0pdbH-pYfHXa8yU2ZBa7-29">
          <mxCell connectable="0" parent="_vKOgibNYJb6RkX7hGH7-1" style="group;transparentBounds=1;editIcon=1;lockedGroup=0;groupPadding=10;" vertex="1">
            <mxGeometry as="geometry" />
          </mxCell>
        </UserObject>
