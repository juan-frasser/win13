        <UserObject label="" mermaidData="{&#xa;  &quot;data&quot;: &quot;erDiagram\n    USUARIO {\n        string ID_Usuario PK\n        string Email\n        string Password\n        string Rol\n    }\n\n    EMPRESA {\n        string ID_Empresa PK\n        string NIT\n        string Razon_Social\n        string Sector\n        string Email_Contacto\n        string ID_Usuario FK \&quot;Referencia a USUARIO\&quot;\n    }\n\n    ESTUDIANTE {\n        string ID_Estudiante PK\n        string Documento_Identidad\n        string Nombres\n        string Programa_Academico\n        int Semestre_Actual\n        string ID_Usuario FK \&quot;Referencia a USUARIO\&quot;\n    }\n\n    VACANTE {\n        string ID_Vacante PK\n        string Titulo_Cargo\n        string Requisitos\n        string Estado\n        string ID_Empresa FK \&quot;Referencia a EMPRESA\&quot;\n    }\n\n    POSTULACION {\n        string ID_Postulacion PK\n        date Fecha_Postulacion\n        string Estado_Proceso\n        string ID_Estudiante FK \&quot;Referencia a ESTUDIANTE\&quot;\n        string ID_Vacante FK \&quot;Referencia a VACANTE\&quot;\n    }\n\n    INFORME_SEGUIMIENTO {\n        string ID_Informe PK\n        date Fecha_Entrega\n        string Observaciones\n        int Calificacion\n        string ID_Postulacion FK \&quot;Referencia a POSTULACION\&quot;\n    }\n\n    %% Relaciones (Cardinalidad)\n    USUARIO ||--o| EMPRESA : \&quot;tiene perfil\&quot;\n    USUARIO ||--o| ESTUDIANTE : \&quot;tiene perfil\&quot;\n    EMPRESA ||--o{ VACANTE : \&quot;publica\&quot;\n    ESTUDIANTE ||--o{ POSTULACION : \&quot;realiza\&quot;\n    VACANTE ||--o{ POSTULACION : \&quot;recibe\&quot;\n    POSTULACION ||--o{ INFORME_SEGUIMIENTO : \&quot;genera\&quot;&quot;,&#xa;  &quot;config&quot;: null,&#xa;  &quot;version&quot;: &quot;12&quot;&#xa;}" id="crGWdJqFGxzgjuFmGuGJ-35">
          <mxCell connectable="0" parent="_vKOgibNYJb6RkX7hGH7-1" style="group;transparentBounds=1;editIcon=1;lockedGroup=0;groupPadding=10;" vertex="1">
            <mxGeometry as="geometry" />
          </mxCell>
        </UserObject>
