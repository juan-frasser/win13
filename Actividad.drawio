        <UserObject label="" plantUmlData="{&#xa;  &quot;data&quot;: &quot;@startuml\nleft to right direction\nskinparam packageStyle rectangle\n\nactor \&quot;Universidad\\n(Administrador)\&quot; as U\nactor \&quot;Estudiante\&quot; as E\nactor \&quot;Empresa\&quot; as EMP\n\nrectangle \&quot;Plataforma de Prácticas Profesionales\&quot; {\n  &#39; Caso de uso transversal\n  usecase \&quot;Iniciar sesión\&quot; as UC_Login\n\n  &#39; Casos de la Universidad\n  usecase \&quot;Registrar estudiantes\\ny empresas\&quot; as UC1\n  usecase \&quot;Gestionar reportes\&quot; as UC2\n  \n  &#39; Casos del Estudiante\n  usecase \&quot;Buscar vacantes\&quot; as UC3\n  usecase \&quot;Filtrar por carrera/salario\&quot; as UC_Filtrar\n  usecase \&quot;Postularse a vacante\&quot; as UC_Postular\n  usecase \&quot;Visualizar estado\\ndel proceso\&quot; as UC4\n  \n  &#39; Casos de la Empresa\n  usecase \&quot;Publicar vacantes\&quot; as UC5\n  usecase \&quot;Registrar informes\&quot; as UC6\n  \n  &#39; Notificaciones compartidas\n  usecase \&quot;Consultar notificaciones\\nde postulación\&quot; as UC7\n\n  &#39; --- CONECTORES INCLUDE (Obligatorios) ---\n  &#39; Para postularse, publicar o gestionar, primero hay que iniciar sesión\n  UC1 ..&gt; UC_Login : &lt;&lt;include&gt;&gt;\n  UC_Postular ..&gt; UC_Login : &lt;&lt;include&gt;&gt;\n  UC5 ..&gt; UC_Login : &lt;&lt;include&gt;&gt;\n  \n  &#39; --- CONECTORES EXTEND (Opcionales) ---\n  &#39; Filtrar es una acción opcional al buscar vacantes\n  UC_Filtrar ..&gt; UC3 : &lt;&lt;extend&gt;&gt;\n}\n\n&#39; Relaciones principales (Asociaciones simples)\nU --&gt; UC1\nU --&gt; UC2\nU --&gt; UC7\n\nE --&gt; UC3\nE --&gt; UC_Postular\nE --&gt; UC4\n\nEMP --&gt; UC5\nEMP --&gt; UC6\nEMP --&gt; UC7\n\n@enduml&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="wEhEXa9IH7WYQR9LdnuJ-36">
          <mxCell connectable="0" parent="_vKOgibNYJb6RkX7hGH7-1" style="group;transparentBounds=1;editIcon=1;lockedGroup=0;groupPadding=10;" vertex="1">
            <mxGeometry as="geometry" />
          </mxCell>
        </UserObject>
